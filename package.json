{
  "name": "codeprooj-client",
  "version": "1.2.7",
  "private": true,
  "description": "CodeProOJ desktop client for Windows, macOS and Linux",
  "main": "main.js",
  "scripts": {
    "build:editor": "node scripts/build-editor.js",
    "prestart": "npm run build:editor",
    "start": "electron .",
    "pretest": "npm run build:editor",
    "test": "node --test scripts/renderer-smoke.test.js",
    "predist:win": "npm run build:editor",
    "dist:win": "electron-builder --win portable",
    "predist:mac": "npm run build:editor",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64",
    "predist:linux": "npm run build:editor",
    "dist:linux": "electron-builder --linux deb --x64",
    "publish:local": "node scripts/publish-local.js"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "katex": "^0.19.1",
    "marked": "^18.1.1"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "build": {
    "appId": "com.codeprooj.client",
    "productName": "CodeProOJ Client",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "renderer/brand-icon.ico",
      "target": "portable",
      "artifactName": "CodeProOJ-Client-${version}.${ext}"
    },
    "mac": {
      "icon": "renderer/brand-mark.svg",
      "target": "dmg",
      "artifactName": "CodeProOJ-Client-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "icon": "build/icons",
      "target": "deb",
      "category": "Development",
      "maintainer": "CodeProOJ",
      "artifactName": "CodeProOJ-Client-${version}-linux-${arch}.${ext}"
    }
  }
}
